# Rust build artifacts
target/

# Workspace-root /Cargo.lock IS tracked for reproducibility (required by
# PHASE3_SLICE3_REPRO_PLAN.md sub-tasks 2 + 4). Stray sub-crate lockfiles
# (workspace members + excluded sub-projects) shouldn't be tracked —
# Cargo writes a single root lockfile for the workspace, and excluded
# sub-projects have their own reproducibility story.
Cargo.lock
!/Cargo.lock

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Project specific
block_tx_counts.bin
data/*.bin
data/*.dat
*.log

# Node.js
node_modules/
dist/
*.tsbuildinfo

# Python
__pycache__/
*.pyc
*.pyo
*.dylib

# Java / Gradle
.gradle/
# Build output directories. The Rust database-builder crate lives under
# `tools/db-builder/`, so this rule no longer shadows tracked source.
build/
!gradle/wrapper/gradle-wrapper.jar
*.class

# macOS local metadata
.DS_Store

# Planning docs are tracked when they are referenced from source/docs.
# Historical root-level PLAN_*.md files live in docs/plans/ with root
# symlink shims for older references; use LOCAL_PLAN_*.md for private
# scratch notes that should stay untracked.
LOCAL_PLAN_*.md

# Claude Code
.claude/
# dream audit-skill working dir (regenerable scratch)
.dream/

# Deployment artifacts (local configs, secrets, notes, SSH known_hosts)
deploy/

# Reviewed, secret-free Payment V1 templates are source files, not rendered
# deployment artifacts. Re-open only their exact paths so a new profile cannot
# pass local tests while silently disappearing from a commit.
!deploy/
deploy/*
# Secret-free operational facts (host keys, install config, service units)
# are tracked so a fresh clone can verify hosts and reconstruct services.
# Secrets (cloudflared_tunnel.env), logs/, and UKI release artifacts stay
# local-only — see deploy/README.md.
!deploy/README.md
!deploy/installimage.conf
!deploy/known_hosts
!deploy/vpsbg_known_hosts
!deploy/systemd/
deploy/systemd/*
!deploy/systemd/cloudflared.service
!deploy/systemd/pir-primary.service
!deploy/systemd/pir-secondary.service
!deploy/systemd/pir-vpsbg.service

# vendor/ holds `cargo vendor` output. Each crate ships a
# `.cargo-checksum.json` listing every file with its hash; dropping any
# referenced file (Cargo.lock, build/*.rs, src/target/*.rs, .DS_Store,
# .claude/*) breaks fresh-clone offline builds with
# "failed to calculate checksum of: vendor/<crate>/<file>".
# Keep vendor/ verbatim — un-ignore everything inside it so the broader
# rules above (target/, build/, .DS_Store, .claude/, Cargo.lock) don't
# bite vendored crates.
!vendor/**
# The vendor re-include above also re-opens files matched by the global
# macOS metadata rule. Keep local Finder state out of vendored sources.
/vendor/**/.DS_Store
# payment-issuer key files (never commit)
arc_key.bin
cashu_key.bin

# Owner-only private keys, ceremony artifacts, and API tokens.
# These are never committed to the repository.
.keys/
.secrets/

# Stray per-machine config dropped in by an unrelated local AI tool; never part of this repository.
/config.json
