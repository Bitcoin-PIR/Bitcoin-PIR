# Rust build artifacts
target/

# Workspace-root /Cargo.lock IS tracked for reproducibility (required by
# PHASE3_SLICE3_REPRO_PLAN.md sub-tasks 2 + 4). Stray sub-crate lockfiles
# (workspace members + excluded sub-projects like
# electrum_plugin/harmonypir-python) shouldn't be tracked — Cargo writes
# a single root lockfile for the workspace, and excluded sub-projects
# have their own reproducibility story.
Cargo.lock
!/Cargo.lock

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Project specific
block_tx_counts.bin
data/*.bin
data/*.dat
*.log

# Node.js
node_modules/
dist/
*.tsbuildinfo

# Python
__pycache__/
*.pyc
*.pyo
*.dylib

# Electrum plugin build artifacts
pir_privacy-*.zip
electrum_plugin/pir_privacy/_vendor/

# Java / Gradle
.gradle/
# Build output directories. The Rust database-builder crate lives under
# `tools/db-builder/`, so this rule no longer shadows tracked source.
build/
!gradle/wrapper/gradle-wrapper.jar
*.class

# macOS local metadata
.DS_Store

# Planning docs are tracked when they are referenced from source/docs.
# Historical root-level PLAN_*.md files live in docs/plans/ with root
# symlink shims for older references; use LOCAL_PLAN_*.md for private
# scratch notes that should stay untracked.
LOCAL_PLAN_*.md

# Claude Code
.claude/
# dream audit-skill working dir (regenerable scratch)
.dream/

# Deployment artifacts (local configs, secrets, notes, SSH known_hosts)
deploy/

# Reviewed, secret-free Payment V1 templates are source files, not rendered
# deployment artifacts. Re-open only their exact paths so a new profile cannot
# pass local tests while silently disappearing from a commit.
!deploy/
deploy/*
!deploy/payment-v1/
deploy/payment-v1/*
!deploy/payment-v1/edge/
deploy/payment-v1/edge/*
!deploy/payment-v1/edge/directory-public-haproxy.cfg.in
!deploy/payment-v1/edge/directory-public-haproxy-build-manifest.json.in
!deploy/payment-v1/edge/integrated-existing-bhtm-caddy-directory-public.managed.Caddyfile.in
!deploy/payment-v1/lightning/
!deploy/payment-v1/lightning/mainnet-lightning-v1/
!deploy/payment-v1/lightning/mainnet-lightning-v1/preflight.toml.example
!deploy/payment-v1/vpsbg/
!deploy/payment-v1/vpsbg/vpsbg-free-pow-service-auth.args.in
!deploy/payment-v1/vpsbg/vpsbg-premium-free-pow-beta-service-auth.args.in
!deploy/payment-v1/vpsbg/vpsbg-premium-free-pow-beta-policy.toml.in
!deploy/payment-v1/systemd/
deploy/payment-v1/systemd/*
!deploy/payment-v1/systemd/bhtm-caddy.directory-public-edge.conf.in
!deploy/payment-v1/systemd/hetzner-provider-direct.service.in
!deploy/payment-v1/systemd/hetzner-provider-no-standard-cashu.service.in
!deploy/payment-v1/systemd/payment-v1-directory-public-edge.service.in
!deploy/payment-v1/systemd/payment-v1-publisher-netns.service.in
!deploy/payment-v1/systemd/payment-v1-directory-publisher.service.in
!deploy/payment-v1/systemd/bhtm-caddy.publisher-netns.conf.in
!deploy/payment-v1/systemd/issuer-lightning-mainnet-v1-preflight.service.in
!deploy/payment-v1/systemd/issuer-lightning-mainnet-v1-core.service.in
!deploy/payment-v1/systemd/issuer-lightning-mainnet-v1-cln-rpc-guard.service.in
!deploy/payment-v1/systemd/issuer-lightning-mainnet-v1-payment-issuer.service.in
!deploy/payment-v1/network/
deploy/payment-v1/network/*
!deploy/payment-v1/network/README.md
!deploy/payment-v1/network/directory-publisher-hosts.conf.in
!deploy/payment-v1/network/directory-publisher-network-policy.json.in
!deploy/payment-v1/network/directory-publisher-resolv.conf.in
!deploy/payment-v1/network/directory-publisher-nsswitch.conf.in

# vendor/ holds `cargo vendor` output. Each crate ships a
# `.cargo-checksum.json` listing every file with its hash; dropping any
# referenced file (Cargo.lock, build/*.rs, src/target/*.rs, .DS_Store,
# .claude/*) breaks fresh-clone offline builds with
# "failed to calculate checksum of: vendor/<crate>/<file>".
# Keep vendor/ verbatim — un-ignore everything inside it so the broader
# rules above (target/, build/, .DS_Store, .claude/, Cargo.lock) don't
# bite vendored crates.
!vendor/**
# The vendor re-include above also re-opens files matched by the global
# macOS metadata rule. Keep local Finder state out of vendored sources.
/vendor/**/.DS_Store
# dev-issuer demo key files (never commit)
arc_key.bin
cashu_key.bin
