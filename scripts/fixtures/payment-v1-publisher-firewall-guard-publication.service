[Unit]
Description=BitcoinPIR disposable firewall-bound publisher
Requires=bitcoinpir-payment-v1-publisher-firewall-guard-owner.service
BindsTo=bitcoinpir-payment-v1-publisher-firewall-guard-owner.service
After=bitcoinpir-payment-v1-publisher-firewall-guard-owner.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/libexec/bitcoinpir-publisher-firewall-guard-publication-probe
Restart=no
TimeoutStartSec=10
TimeoutStopSec=5
StandardOutput=null
StandardError=null
