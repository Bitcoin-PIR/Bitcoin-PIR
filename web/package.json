{
  "name": "bitcoin-batch-pir-web-client",
  "version": "1.0.0",
  "description": "Web client for Bitcoin Batch PIR system (two-level)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "vite",
    "build-web": "vite build && node scripts/verify-csp.mjs",
    "test": "npm run test:production-canary-readiness && vitest run",
    "test:production-canary-readiness": "node scripts/verify-production-canary-readiness.mjs",
    "test:e2e:strict-production": "playwright test --config playwright.production.config.ts"
  },
  "keywords": [
    "bitcoin",
    "pir",
    "dpf",
    "privacy",
    "batch"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@cashu/cashu-ts": "4.10.1",
    "buffer": "^6.0.3",
    "hash.js": "^1.1.7",
    "pir-sdk-wasm": "file:../crates/sdk/wasm/pkg"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.18.1",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.0.0",
    "vite": "^8.2.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^3.2.7",
    "ws": "^8.21.3",
    "yaml": "2.9.0"
  }
}
