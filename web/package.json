{
  "name": "bitcoin-batch-pir-web-client",
  "version": "1.0.0",
  "description": "Web client for Bitcoin Batch PIR system (two-level)",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "vite",
    "build-web": "vite build && node scripts/verify-csp.mjs",
    "test": "vitest run"
  },
  "keywords": [
    "bitcoin",
    "pir",
    "dpf",
    "privacy",
    "batch"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@cashu/cashu-ts": "4.10.2",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "hash.js": "^1.1.7",
    "pir-sdk-wasm": "file:../crates/sdk/wasm/pkg"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.0.0",
    "vite": "^8.3.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^3.2.7",
    "ws": "^8.21.3"
  }
}
