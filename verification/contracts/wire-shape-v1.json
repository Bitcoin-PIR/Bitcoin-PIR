{
  "schema": "BitcoinPIR/wire-shape-contract/v1",
  "contractVersion": 1,
  "description": "Public protocol parameters and leakage axes covered by the EasyCrypt simulator-property proof.",
  "parameters": {
    "indexGroups": 75,
    "chunkGroups": 80,
    "indexCuckooHashes": 2
  },
  "backends": {
    "dpf": {
      "deploymentServerCount": 2,
      "formalPirRoundServerIds": [0, 1]
    },
    "harmony": {
      "deploymentServerCount": 2,
      "formalPirRoundServerIds": [0]
    },
    "onion": {
      "deploymentServerCount": 1,
      "formalPirRoundServerIds": [0]
    }
  },
  "roundKinds": [
    "index",
    "chunk",
    "index_merkle_siblings",
    "chunk_merkle_siblings",
    "harmony_hint_refresh",
    "onion_key_register",
    "info",
    "merkle_tree_tops"
  ],
  "admittedLeakage": [
    "index_max_items_per_group_per_level",
    "chunk_max_items_per_group_per_level",
    "session_query_index",
    "query_db_id"
  ],
  "explicitNonClaims": [
    "timing_channels",
    "onionpir_server_lru_eviction_retries",
    "connection_level_metadata",
    "compression_artifacts",
    "cryptographic_primitive_reductions",
    "mechanical_correspondence_to_the_rust_implementation"
  ],
  "implementationSurfaces": [
    "pir-core/src/params.rs",
    "pir-sdk/src/leakage.rs",
    "pir-sdk-client/src/dpf.rs",
    "pir-sdk-client/src/harmony.rs",
    "pir-sdk-client/src/onion.rs",
    "pir-sdk-client/src/onion_merkle.rs",
    "pir-sdk-client/tests/leakage_integration_test.rs",
    "pir-sdk-wasm/src/harmony_wire.rs",
    "web/src/leakage.ts",
    "web/src/onionpir_client.ts"
  ]
}
