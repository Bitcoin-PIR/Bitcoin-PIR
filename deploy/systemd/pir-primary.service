# pir1 (Hetzner, no TEE) as it runs: DPF server 0, OnionPIR and HarmonyPIR
# hints; it also answers HarmonyPIR queries. The binary is installed
# content-addressed under /opt/bitcoinpir/unified-server/<sha256>/ (Flow D in
# docs/PRODUCTION_OPERATIONS.md); the identity and database paths keep their
# Payment V1 names. `--pool-dir` keeps generated hint-pool entries across
# restarts (each is still served at most once). Startup to `Listening` takes
# about 2 min 20 s. A node of your own: docs/OPERATOR_GUIDE.md.
[Unit]
Description=BitcoinPIR unified server (primary: DPF-0 + OnionPIR + HarmonyPIR hints + HarmonyPIR query)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pir
Group=pir
UMask=0077
StateDirectory=bitcoinpir-provider-functional-beta
StateDirectoryMode=0700
WorkingDirectory=/var/lib/bitcoinpir-provider-functional-beta
ExecStartPre=/usr/bin/test -x /opt/bitcoinpir/unified-server/<sha256>/unified_server
ExecStart=/opt/bitcoinpir/unified-server/<sha256>/unified_server \
    --bind-address 127.0.0.1 \
    --port 8091 \
    --role primary \
    --serve-hints \
    --serve-queries \
    --pool-size 8 \
    --pool-dir /var/lib/bitcoinpir-provider-functional-beta/hint-pool \
    --config /etc/bitcoinpir/payment-v1/functional-beta/provider/databases.toml \
    --identity-key-path /etc/bitcoinpir/payment-v1/functional-beta/provider/provider-identity.key \
    --identity-cert-path /etc/bitcoinpir/payment-v1/functional-beta/provider/provider-identity.cert \
    --identity-server-id pir1-payment-beta \
    --max-connections 128 \
    --websocket-handshake-timeout-ms 10000 \
    --connection-idle-timeout-ms 300000 \
    --credit-issuer-pubkey /etc/bitcoinpir/issuer/grant.pub \
    --credit-issuer-url https://cashier.bitcoinpir.org \
    --require-credits \
    --access dpf=best-effort:2 \
    --access harmony=best-effort:1:1500000 \
    --access onion=best-effort:1:3000000 \
    --api-key-file /etc/bitcoinpir/api-keys \
    --free-threads 2
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
