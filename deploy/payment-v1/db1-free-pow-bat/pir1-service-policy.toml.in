# pir1 db0+db1 Free-PoW + BAT policy
#
# Complete source template: render every @...@ placeholder, inspect the scope
# IDs, create one fresh BAT binding per scope, then sign the complete policy.
# This file is inert source and is not deployment or funds authorization.

operator_pubkey_hex = "@PIR1_OPERATOR_PUBKEY_HEX@"
stable_server_id = "@PIR1_STABLE_SERVER_ID@"
policy_epoch = @PIR1_POLICY_EPOCH@
issued_at = @POLICY_ISSUED_AT_UNIX@
expires_at = @POLICY_EXPIRES_AT_UNIX@
auth_padding_class = "16-kib"

[[scopes]]
backend = "dpf-pir-v1"
workload = "dpf-evaluate-job-v1"
protocol_version = 1
operation_profile = @PIR1_DPF_DB0_OPERATION_PROFILE@
entitlement_profile = @PIR1_DPF_DB0_ENTITLEMENT_PROFILE@

[scopes.dataset]
kind = "manifest-root"
root_hex = "@PIR1_DB0_PROOF_V1_MANIFEST_ROOT_HEX@"

[scopes.limits]
max_logical_inputs = @PIR1_DPF_DB0_MAX_LOGICAL_INPUTS@
max_frames = @PIR1_DPF_DB0_MAX_FRAMES@
max_request_bytes = @PIR1_DPF_DB0_MAX_REQUEST_BYTES@
max_response_bytes = @PIR1_DPF_DB0_MAX_RESPONSE_BYTES@
max_wall_time_ms = @PIR1_DPF_DB0_MAX_WALL_TIME_MS@
max_concurrent_sockets = @PIR1_DPF_DB0_MAX_CONCURRENT_SOCKETS@
max_hint_groups = @PIR1_DPF_DB0_MAX_HINT_GROUPS@
max_work_units = @PIR1_DPF_DB0_MAX_WORK_UNITS@

[[scopes.offers]]
offer_id = 101
acquisition = "free"
free_mode = "proof-of-work"
free_pow_difficulty_bits = @PIR1_DPF_DB0_FREE_POW_DIFFICULTY_BITS@
priority_class = 1
authorization = "free"
verification = "provider-local"
deployment_status = "stable"
minimum_credential_validity_seconds = 1
retired_policy_grace_seconds = 0
credential_count = 1
credential_presentation_limit = 1
privacy_leakage_bits = 0

[scopes.offers.price]
kind = "free"

[[scopes.offers]]
offer_id = 102
acquisition = "bolt11"
free_mode = "not-free"
priority_class = 1
authorization = "cashu-bat"
verification = "shared-issuer-online"
deployment_status = "stable"
issuer_id_hex = "@BAT_ISSUER_ID_HEX@"
key_id_hex = "@PIR1_DPF_DB0_BAT_KEY_ID_HEX@"
credential_binding_path = "bindings/db0/dpf-evaluate-job-v1/cashu-bat.bin"
endpoint = "@BAT_ISSUER_ORIGIN@"
invoice_expiry_seconds = @BAT_INVOICE_EXPIRY_SECONDS@
claim_window_seconds = @BAT_CLAIM_WINDOW_SECONDS@
minimum_credential_validity_seconds = @BAT_MINIMUM_CREDENTIAL_VALIDITY_SECONDS@
retired_policy_grace_seconds = @BAT_RETIRED_POLICY_GRACE_SECONDS@
credential_count = @PIR1_DPF_DB0_BAT_CREDENTIAL_COUNT@
credential_presentation_limit = 1
privacy_leakage_bits = 28

[scopes.offers.price]
kind = "msat"
amount = @PIR1_DPF_DB0_BAT_PRICE_MSAT@

