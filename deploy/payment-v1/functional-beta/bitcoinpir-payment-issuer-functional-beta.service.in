# BitcoinPIR Payment V1 functional-beta issuer. Render every @...@ value
# before installing it as bitcoinpir-payment-issuer-functional-beta.service.
#
# This unit is deliberately independent of the existing dev issuer and paid
# issuer templates: it has its own unit name, user, state directory, config
# tree, loopback port and artifact path.
[Unit]
Description=BitcoinPIR Payment V1 functional-beta payment issuer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@FUNCTIONAL_BETA_ISSUER_USER@
Group=@FUNCTIONAL_BETA_ISSUER_GROUP@
UMask=0077
StateDirectory=bitcoinpir-payment-issuer-functional-beta
StateDirectoryMode=0700
WorkingDirectory=/var/lib/bitcoinpir-payment-issuer-functional-beta
ExecStartPre=/usr/bin/test -x /opt/bitcoinpir/payment-issuer/@PAYMENT_ISSUER_SHA256@/payment-issuer
ExecStart=/opt/bitcoinpir/payment-issuer/@PAYMENT_ISSUER_SHA256@/payment-issuer serve-cln \
    --bind 127.0.0.1:@FUNCTIONAL_BETA_ISSUER_PORT@ \
    --max-connections 128 \
    --quote-rate-per-minute 60 \
    --status-rate-per-minute 600 \
    --mutation-rate-per-minute 120 \
    --reconciliation-rate-per-minute 120 \
    --reconciliation-batch-size 32 \
    --reconciliation-interval-seconds 15 \
    --reconciliation-tick-budget-ms 5000 \
    --max-outstanding-quotes 4096 \
    --max-total-quotes 16384 \
    --allow-origin @BITCOINPIR_WEB_ORIGIN@ \
    --store /var/lib/bitcoinpir-payment-issuer-functional-beta/issuer.sqlite3 \
    --rollback-authority /var/lib/bitcoinpir-payment-issuer-functional-beta/rollback.sqlite3 \
    --allow-local-rollback-authority-dev \
    --quote-delegation /etc/bitcoinpir/payment-v1/functional-beta/issuer/quote-delegation.bin \
    --quote-signing-key /etc/bitcoinpir/payment-v1/functional-beta/issuer/quote-signing.key \
    --credential-derivation-key /etc/bitcoinpir/payment-v1/functional-beta/issuer/credential-derivation.key \
    --service-policy /etc/bitcoinpir/payment-v1/functional-beta/issuer/service-policy.bin=@POLICY_PUBKEY_HEX@ \
    --receipt-signing-key /etc/bitcoinpir/payment-v1/functional-beta/issuer/direct-receipt-signing.key \
    --bat-key /etc/bitcoinpir/payment-v1/functional-beta/issuer/cashu-bat.key \
    --arc-key @ARC_KEY_ID_HEX@=/etc/bitcoinpir/payment-v1/functional-beta/issuer/arc-experimental.key \
    --allow-experimental-arc \
    --clearing-authorization /etc/bitcoinpir/payment-v1/functional-beta/issuer/provider-clearing-authorization.bin \
    --clearing-approval /etc/bitcoinpir/payment-v1/functional-beta/issuer/provider-clearing-approval.bin \
    --clearing-provider-request-verifying-key /etc/bitcoinpir/payment-v1/functional-beta/issuer/provider-request-verifying.key \
    --issuer-settlement-signing-key /etc/bitcoinpir/payment-v1/functional-beta/issuer/issuer-settlement-signing.key \
    --redeem-response-derivation-key /etc/bitcoinpir/payment-v1/functional-beta/issuer/redeem-response-derivation.key \
    --cln-rpc-socket @CLN_RPC_SOCKET@ \
    --cln-rpc-expected-uid @CLN_RPC_UID@ \
    --cln-rpc-expected-gid @CLN_RPC_GID@ \
    --cln-rpc-timeout-seconds 10
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
