# Append this rendered fragment to the existing Hetzner Caddyfile. It does not
# replace or restart any existing PIR or dev-issuer service. Caddy forwards
# WebSocket upgrades automatically, so the provider route carries /v1/pir and
# the issuer route carries the direct-receipt and shared-redeem HTTP APIs.

@FUNCTIONAL_BETA_PROVIDER_WSS_HOST@ {
	handle /v1/pir {
		reverse_proxy 127.0.0.1:@FUNCTIONAL_BETA_PROVIDER_PORT@
	}

	handle {
		respond "" 404
	}
}

@FUNCTIONAL_BETA_ISSUER_HTTPS_HOST@ {
	handle {
		reverse_proxy 127.0.0.1:@FUNCTIONAL_BETA_ISSUER_PORT@
	}
}
