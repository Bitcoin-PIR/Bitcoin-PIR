# Mainnet Lightning V1 read-only live-preflight profile. Never install this
# source template directly. Rendering supplies public identities and SHA-256
# pins only; it supplies no wallet secret, signing key, funds, or authority to
# create/pay an invoice.

schema_version = 1
profile = "mainnet-lightning-v1"
network = "bitcoin"
bitcoin_genesis_hash = "000000000019d6689c085ae165831e934ff763ae46a2a6c172b3f1b60a8ce26f"
bolt11_hrp = "lnbc"
capability = "direct-bolt11-dpf"
credential_count = 1
settlement = "ledger-only"
payout = "disabled"
cashu = "forbidden"
arc = "forbidden"

expected_issuer_id_hex = "@MAINNET_EXPECTED_ISSUER_ID_HEX@"
expected_payee_node_id_hex = "@MAINNET_PAYEE_NODE_ID_HEX@"
command_timeout_seconds = 10
max_block_height_lag = 2

# The selector is deliberately explicit. Only local read-only RPC methods are
# appended by bpir-admin; credentials and positional methods are rejected.
[bitcoin]
cli_args = [
  "-chain=main",
  "-rpcconnect=127.0.0.1",
  "-rpcport=@BITCOIN_RPC_PORT@",
  "-rpccookiefile=/srv/bitcoin/.cookie",
]

[bitcoin.cli]
path = "/opt/bitcoinpir/bitcoin-core/@BITCOIN_CORE_BUNDLE_SHA256@/bin/bitcoin-cli"
protected_parent = "/opt/bitcoinpir/bitcoin-core/@BITCOIN_CORE_BUNDLE_SHA256@"
sha256_hex = "@MAINNET_BITCOIN_CLI_SHA256@"
expected_uid = 0
expected_gid = 0

[lightning]
rpc_socket = "/srv/lightning/bitcoin/lightning-rpc"

[lightning.cli]
path = "/opt/bitcoinpir/core-lightning/@CLN_BUNDLE_SHA256@/bin/lightning-cli"
protected_parent = "/opt/bitcoinpir/core-lightning/@CLN_BUNDLE_SHA256@"
sha256_hex = "@MAINNET_LIGHTNING_CLI_SHA256@"
expected_uid = 0
expected_gid = 0

[quote_delegation]
path = "/etc/bitcoinpir/payment-v1/mainnet-lightning-v1/quote-delegation.bin"
protected_parent = "/etc/bitcoinpir/payment-v1/mainnet-lightning-v1"
expected_uid = 0
expected_gid = @MAINNET_PREFLIGHT_GID@
sha256_hex = "@MAINNET_QUOTE_DELEGATION_SHA256@"

[backup]
max_age_seconds = 3600

[backup.receipt]
path = "/etc/bitcoinpir/payment-v1/mainnet-lightning-v1/backup-receipt.toml"
protected_parent = "/etc/bitcoinpir/payment-v1/mainnet-lightning-v1"
expected_uid = 0
expected_gid = @MAINNET_PREFLIGHT_GID@
sha256_hex = "@MAINNET_BACKUP_RECEIPT_SHA256@"

[custody]
identity_restore_evidence_sha256 = "@MAINNET_IDENTITY_RESTORE_EVIDENCE_SHA256@"
channel_recovery_restore_evidence_sha256 = "@MAINNET_CHANNEL_RECOVERY_EVIDENCE_SHA256@"
datastore_restore_evidence_sha256 = "@MAINNET_DATASTORE_RESTORE_EVIDENCE_SHA256@"
custody_operation_authorized = false

[risk]
# Non-zero limits make checked arithmetic and live liquidity/exposure checks
# meaningful. They remain public caps, not permission to add funds.
max_invoice_msat = @CLN_GUARD_MAX_INVOICE_MSAT@
max_total_exposure_msat = @MAINNET_MAX_TOTAL_EXPOSURE_MSAT@
max_invoices_per_runtime = @CLN_GUARD_MAX_INVOICES_PER_RUNTIME@
max_payment_attempts = 1

[operation]
read_only_node_contact = true
invoice_creation = false
payment_execution = false
